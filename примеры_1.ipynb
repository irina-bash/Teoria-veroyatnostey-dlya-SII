      ]
     },
     "execution_count": 29,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "from scipy.integrate import quad\n",
    "\n",
    "def f1(x):\n",
    "    return min(x + 15/60, 1)\n",
    "\n",
    "def f2(x):\n",
    "    return max(x - 15/60, 0)\n",
    "\n",
    "r1 = quad(f1, 0, 1)\n",
    "r2 = quad(f2, 0, 1)\n",
    "\n",
    "round(r1[0] - r2[0], 4)"
   ]
